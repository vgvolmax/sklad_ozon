  "formula_contract": {
    "commission": {
      "excel": "I = H * G",
      "canonical": "commission = price * commission_rate"
    },
    "acquiring": {
      "excel": "J = G * 2%",
      "canonical": "acquiring = price * acquiring_rate",
      "observed_workbook_rate": "0.02",
      "note": "Workbook cell comment says 'В среднем 1,5%', but executable formulas use 2%; formulas are authoritative for parity."
    },
    "fbo_logistics": {
      "excel": [
        "R = O + P + Q; populated workbook rows are FBO so P is blank/0 and Q = 25",
        "S = O",
        "U = (100/T) * R + (100/T - 1) * S"
      ],
      "canonical": [
        "base_delivery_tariff = ExpectedLogisticsResult.expected_fee from Task 13",
        "delivery_once = base_delivery_tariff + fixed_fbo_fee",
        "reverse_logistics_tariff = base_delivery_tariff",
        "expected_logistics = delivery_once / buyout_rate + (1 / buyout_rate - 1) * reverse_logistics_tariff"
      ],
      "observed_fixed_fbo_fee": "25",
      "observed_buyout_rate": "0.95",
      "critical": "Task 13 expected_fee is the one-way base tariff O, not the final buyout-adjusted workbook logistics U."
    },
    "advertising_and_services": {
      "excel": "X = W * G",
      "canonical": "advertising_and_services = price * advertising_rate"
    },
    "ozon_withholdings": {
      "excel": "Y = I + J + U + X",
      "canonical": "ozon_withholdings = commission + acquiring + expected_logistics + advertising_and_services"
    },
    "payout": {
      "excel": "AA = G - Y",
      "canonical": "payout = price - ozon_withholdings"
    },
    "co_invest": {
      "excel": "AE = G * (1 - AB)",
      "canonical": [
        "co_invest = price * co_invest_rate",
        "realization = price - co_invest"
      ],
      "critical": "Co-invest is not included in Y (Ozon withholdings) and is not subtracted from profit a second time; in this workbook it changes realization/tax bases."
    },
    "vat": {
      "excel": "AG = AE * AF / (1 + AF), or 0 when AF is blank",
      "canonical": "vat = realization * vat_rate / (1 + vat_rate)",
      "meaning": "VAT is treated as included in realization."
    },
    "income_tax_base": {
      "reference_mapping": {
        "УСН-доходы": 1,
        "АУСН-доходы": 1,
        "УСН Д-Р": 2,
        "АУСН Д-Р": 2,
        "Не считать налог": 3
      },
      "excel": {
        "id_1": "AH = AE - AG",
        "id_2": "AH = AA - F - AG",
        "id_3": "AH = 0"
      },
      "canonical": {
        "usn_income": "income_tax_base = realization - vat",
        "usn_income_minus_expenses": "income_tax_base = payout - cost - vat"
      }
    },
    "income_tax": {
      "excel": "AI = AH * AD; several template blocks wrap this in IF(AH*AD<0,0,AH*AD)",
      "canonical_for_golden_cases": "income_tax = max(0, income_tax_base * income_tax_rate)",
      "known_workbook_inconsistency": "Rows are split between clamped and unclamped negative tax formulas. Golden tax cases use positive tax bases, so this inconsistency does not affect the oracle. Do not infer negative-tax credits."
    },
    "total_tax": {
      "excel": "AJ = AI + AG",
      "canonical": "tax = income_tax + vat"
    },
    "profit": {
      "excel": "AL = AA - AJ - F",
      "canonical": "profit_per_unit = payout - tax - cost"
    },
    "margin": {
      "excel": "AM = AL / G with IFERROR",
      "canonical": "margin_rate = profit_per_unit / price; None when price == 0"
    },
    "roi": {
